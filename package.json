{
  "name": "skyscribe-sdk",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "docs:dev": "npm run dev --workspace=apps/docs",
    "docs:build": "npm run build --workspace=apps/docs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@nuxt/schema": "^3.21.11",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.15"
    }
  }
}
